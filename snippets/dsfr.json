{
  "En-tête de page DSFR": {
    "prefix": [
      "dsfr-entete",
      "dsfr-front-matter"
    ],
    "description": "En-tête de page (à mettre tout en haut du fichier) : fil d'Ariane et sommaire",
    "body": [
      "---",
      "breadcrumb:",
      "  - Accueil: /",
      "  - ${1:Rubrique}: ${2:/rubrique/}",
      "  - ${3:Titre de la page}",
      "summary: ${4|true,false|}",
      "---",
      "",
      "# ${3:Titre de la page}",
      "",
      "$0"
    ]
  },
  "Bandeau d'information (en-tête)": {
    "prefix": [
      "dsfr-bandeau",
      "dsfr-notice"
    ],
    "description": "Bandeau d'information importante : clés à placer dans l'en-tête --- de la page",
    "body": [
      "notice:",
      "  type: ${1|info,warning,alert|}",
      "  description: \"${2:Texte du bandeau}\"",
      "  link_label: ${3:En savoir plus}",
      "  link_url: ${4:https://}",
      "$0"
    ]
  },
  "Fil d'Ariane (en-tête)": {
    "prefix": [
      "dsfr-fil-ariane",
      "dsfr-breadcrumb"
    ],
    "description": "Fil d'Ariane : clés à placer dans l'en-tête --- de la page",
    "body": [
      "breadcrumb:",
      "  - Accueil: /",
      "  - ${1:Rubrique}: ${2:/rubrique/}",
      "  - ${3:Titre de la page}",
      "$0"
    ]
  },
  "Sommaire (en-tête)": {
    "prefix": [
      "dsfr-sommaire",
      "dsfr-summary"
    ],
    "description": "Sommaire des titres de niveau 2 et 3 : clé à placer dans l'en-tête --- de la page",
    "body": [
      "summary: true",
      "$0"
    ]
  },
  "Lettre d'information (en-tête)": {
    "prefix": [
      "dsfr-lettre-info",
      "dsfr-newsletter"
    ],
    "description": "Lettre d'information et réseaux sociaux : clés à placer dans l'en-tête --- de la page",
    "body": [
      "newsletter:",
      "  title: ${1:Abonnez-vous à la lettre d'information}",
      "  description: ${2:Description}",
      "  button: ${3:S'abonner}",
      "  button_url: ${4:https://}",
      "$0"
    ]
  },
  "Alerte DSFR": {
    "prefix": [
      "dsfr-alerte",
      "dsfr-alert"
    ],
    "description": "Alerte DSFR avec titre (info, succès, attention, erreur)",
    "body": [
      "/// alert | ${1:Titre de l'alerte}",
      "    type: ${2|info,success,warning,error|}",
      "${3:Texte de l'alerte}",
      "///",
      "$0"
    ]
  },
  "Alerte DSFR sans titre": {
    "prefix": [
      "dsfr-alerte-simple"
    ],
    "description": "Petite alerte DSFR sans titre",
    "body": [
      "/// alert",
      "    type: ${1|info,success,warning,error|}",
      "${2:Texte de l'alerte}",
      "///",
      "$0"
    ]
  },
  "Accordéon DSFR": {
    "prefix": [
      "dsfr-accordeon",
      "dsfr-accordion"
    ],
    "description": "Accordéon DSFR (contenu repliable)",
    "body": [
      "/// accordion | ${1:Intitulé de l'accordéon}",
      "    open: ${2|false,true|}",
      "${3:Contenu}",
      "///",
      "$0"
    ]
  },
  "Badge DSFR": {
    "prefix": [
      "dsfr-badge"
    ],
    "description": "Badge DSFR",
    "body": [
      "/// badge",
      "    type: ${1|info,success,warning,error,new|}",
      "${2:Libellé}",
      "///",
      "$0"
    ]
  },
  "Badge DSFR coloré": {
    "prefix": [
      "dsfr-badge-couleur"
    ],
    "description": "Badge DSFR de couleur illustrative",
    "body": [
      "/// badge",
      "    color: ${1|green-menthe,green-emeraude,blue-ecume,purple-glycine,pink-tuile,yellow-tournesol,orange-terre-battue,brown-caramel,beige-gris-galet|}",
      "${2:Libellé}",
      "///",
      "$0"
    ]
  },
  "Mise en avant DSFR": {
    "prefix": [
      "dsfr-mise-en-avant",
      "dsfr-callout"
    ],
    "description": "Mise en avant DSFR (callout) avec bouton facultatif",
    "body": [
      "/// callout | ${1:Titre de la mise en avant}",
      "    icon: ${2:information-line}",
      "    link_label: ${3:En savoir plus}",
      "    link_url: ${4:https://}",
      "${5:Texte de la mise en avant}",
      "///",
      "$0"
    ]
  },
  "Citation DSFR": {
    "prefix": [
      "dsfr-citation",
      "dsfr-quote"
    ],
    "description": "Citation DSFR avec auteur",
    "body": [
      "/// quote | ${1:Auteur}",
      "    size: ${2|md,lg,xl|}",
      "« ${3:Texte de la citation} »",
      "///",
      "$0"
    ]
  },
  "Mise en exergue DSFR": {
    "prefix": [
      "dsfr-exergue",
      "dsfr-highlight"
    ],
    "description": "Mise en exergue DSFR (citation Markdown « > »)",
    "body": [
      "> ${1:Texte mis en exergue}",
      "$0"
    ]
  },
  "Carte DSFR": {
    "prefix": [
      "dsfr-carte",
      "dsfr-card"
    ],
    "description": "Carte DSFR avec lien (dsfr-carte-2 ou dsfr-carte-3 : plusieurs cartes côte à côte)",
    "body": [
      "/// card | ${1:Titre de la carte}",
      "    description: ${2:Description}",
      "    target: ${3:page.md}",
      "    badge: ${4:Nouveau | green-menthe}",
      "${5:Détail}",
      "///",
      "$0"
    ]
  },
  "2 cartes côte à côte": {
    "prefix": [
      "dsfr-carte-2",
      "dsfr-cartes-2",
      "dsfr-card-2"
    ],
    "description": "Deux cartes DSFR côte à côte (grille de 2 colonnes, l'une sous l'autre sur mobile)",
    "body": [
      "/// row | fr-grid-row--gutters",
      "/// col | 12 md-6",
      "/// card | ${1:Titre de la carte 1}",
      "    description: ${2:Description}",
      "    target: ${3:page.md}",
      "///",
      "///",
      "/// col | 12 md-6",
      "/// card | ${4:Titre de la carte 2}",
      "    description: ${5:Description}",
      "    target: ${6:page.md}",
      "///",
      "///",
      "///",
      "$0"
    ]
  },
  "3 cartes côte à côte": {
    "prefix": [
      "dsfr-carte-3",
      "dsfr-cartes-3",
      "dsfr-card-3"
    ],
    "description": "Trois cartes DSFR côte à côte (grille de 3 colonnes, l'une sous l'autre sur mobile)",
    "body": [
      "/// row | fr-grid-row--gutters",
      "/// col | 12 md-4",
      "/// card | ${1:Titre de la carte 1}",
      "    description: ${2:Description}",
      "    target: ${3:page.md}",
      "///",
      "///",
      "/// col | 12 md-4",
      "/// card | ${4:Titre de la carte 2}",
      "    description: ${5:Description}",
      "    target: ${6:page.md}",
      "///",
      "///",
      "/// col | 12 md-4",
      "/// card | ${7:Titre de la carte 3}",
      "    description: ${8:Description}",
      "    target: ${9:page.md}",
      "///",
      "///",
      "///",
      "$0"
    ]
  },
  "Tuile DSFR": {
    "prefix": [
      "dsfr-tuile",
      "dsfr-tile"
    ],
    "description": "Une tuile DSFR avec pictogramme (dsfr-tuile-2 ou dsfr-tuile-3 : plusieurs tuiles côte à côte)",
    "body": [
      "/// tile | ${1:Titre de la tuile}",
      "    description: ${2:Description}",
      "    target: ${3:page.md}",
      "    picto: ${4|document/document,buildings/city-hall,digital/mail-send,system/information,institutions/money|}",
      "///",
      "$0"
    ]
  },
  "2 tuiles côte à côte": {
    "prefix": [
      "dsfr-tuile-2",
      "dsfr-tuiles-2",
      "dsfr-tile-2"
    ],
    "description": "Deux tuiles DSFR côte à côte (grille de 2 colonnes, l'une sous l'autre sur mobile)",
    "body": [
      "/// row | fr-grid-row--gutters",
      "/// col | 12 md-6",
      "/// tile | ${1:Titre de la tuile 1}",
      "    description: ${2:Description}",
      "    target: ${3:page.md}",
      "    picto: ${4|document/document,buildings/city-hall,digital/mail-send,system/information,institutions/money|}",
      "///",
      "///",
      "/// col | 12 md-6",
      "/// tile | ${5:Titre de la tuile 2}",
      "    description: ${6:Description}",
      "    target: ${7:page.md}",
      "    picto: ${8|document/document,buildings/city-hall,digital/mail-send,system/information,institutions/money|}",
      "///",
      "///",
      "///",
      "$0"
    ]
  },
  "3 tuiles côte à côte": {
    "prefix": [
      "dsfr-tuile-3",
      "dsfr-tuiles-3",
      "dsfr-tile-3"
    ],
    "description": "Trois tuiles DSFR côte à côte (grille de 3 colonnes, l'une sous l'autre sur mobile)",
    "body": [
      "/// row | fr-grid-row--gutters",
      "/// col | 12 md-4",
      "/// tile | ${1:Titre de la tuile 1}",
      "    description: ${2:Description}",
      "    target: ${3:page.md}",
      "    picto: ${4|document/document,buildings/city-hall,digital/mail-send,system/information,institutions/money|}",
      "///",
      "///",
      "/// col | 12 md-4",
      "/// tile | ${5:Titre de la tuile 2}",
      "    description: ${6:Description}",
      "    target: ${7:page.md}",
      "    picto: ${8|document/document,buildings/city-hall,digital/mail-send,system/information,institutions/money|}",
      "///",
      "///",
      "/// col | 12 md-4",
      "/// tile | ${9:Titre de la tuile 3}",
      "    description: ${10:Description}",
      "    target: ${11:page.md}",
      "    picto: ${12|document/document,buildings/city-hall,digital/mail-send,system/information,institutions/money|}",
      "///",
      "///",
      "///",
      "$0"
    ]
  },
  "Grille DSFR 2 colonnes": {
    "prefix": [
      "dsfr-grille",
      "dsfr-row"
    ],
    "description": "Grille DSFR : une ligne et deux colonnes",
    "body": [
      "/// row | fr-grid-row--gutters",
      "/// col | 12 md-6",
      "${1:Colonne 1}",
      "///",
      "/// col | 12 md-6",
      "${2:Colonne 2}",
      "///",
      "///",
      "$0"
    ]
  },
  "Onglets DSFR": {
    "prefix": [
      "dsfr-onglets",
      "dsfr-tabs"
    ],
    "description": "Système d'onglets DSFR (2 onglets)",
    "body": [
      "/// tabs",
      "/// tab | ${1:Onglet 1}",
      "${2:Contenu du premier onglet}",
      "///",
      "/// tab | ${3:Onglet 2}",
      "${4:Contenu du deuxième onglet}",
      "///",
      "///",
      "$0"
    ]
  },
  "Groupe de boutons DSFR": {
    "prefix": [
      "dsfr-boutons",
      "dsfr-buttons"
    ],
    "description": "Groupe de boutons DSFR",
    "body": [
      "/// buttons",
      "    inline: ${1|inline,vertical|}",
      "/// button | ${2:Bouton principal}",
      "    target: ${3:https://}",
      "///",
      "/// button | ${4:Bouton secondaire}",
      "    kind: secondary",
      "    target: ${5:https://}",
      "///",
      "///",
      "$0"
    ]
  },
  "Bouton DSFR": {
    "prefix": [
      "dsfr-bouton",
      "dsfr-button"
    ],
    "description": "Bouton DSFR seul",
    "body": [
      "/// button | ${1:Libellé}",
      "    kind: ${2|secondary,tertiary,tertiary-no-outline|}",
      "    target: ${3:https://}",
      "///",
      "$0"
    ]
  },
  "Image DSFR avec légende": {
    "prefix": [
      "dsfr-image",
      "dsfr-media-image"
    ],
    "description": "Contenu média DSFR : image avec légende",
    "body": [
      "/// media | ${1:Légende de l'image}",
      "    type: image",
      "    url: ${2:../images/capture.png}",
      "    ratio: ${3|16x9,4x3,1x1,3x2|}",
      "///",
      "$0"
    ]
  },
  "Image Doc SIRH": {
    "prefix": [
      "dsfr-img"
    ],
    "body": [
      "![$2](https://docsirh.e2.rie.gouv.fr/fichiers/$1)$0"
    ],
    "description": "Image hébergée dans les fichiers de Doc SIRH : le curseur se place après « fichiers/ » pour compléter le chemin, puis Tab passe à la description de l'image (lue par les lecteurs d'écran)."
  },
  "Vidéo DSFR": {
    "prefix": [
      "dsfr-video",
      "dsfr-media-video"
    ],
    "description": "Contenu média DSFR : vidéo",
    "body": [
      "/// media | ${1:Légende de la vidéo}",
      "    type: video",
      "    url: ${2:video.mp4}",
      "///",
      "$0"
    ]
  },
  "Tableau DSFR avec légende": {
    "prefix": [
      "dsfr-tableau",
      "dsfr-table"
    ],
    "description": "Tableau DSFR avec légende [entre crochets] en dernière ligne",
    "body": [
      "| ${1:Colonne 1} | ${2:Colonne 2} |",
      "|---|---|",
      "| ${3:Valeur} | ${4:Valeur} |",
      "[${5:Légende du tableau}]",
      "$0"
    ]
  },
  "Doc SIRH : page de mode opératoire": {
    "prefix": [
      "dsfr-sirh-modop"
    ],
    "description": "Doc SIRH — squelette d'un MODOP : titre, fil d'Ariane, suivi des modifications, documents de référence, contexte",
    "body": [
      "---",
      "title: '${1:Titre du mode opératoire}'",
      "---",
      "",
      "<nav role=\"navigation\" class=\"fr-breadcrumb\" aria-label=\"vous êtes ici :\">",
      "    <button class=\"fr-breadcrumb__button\" aria-expanded=\"false\" aria-controls=\"breadcrumb-1\">Voir le fil d’Ariane</button>",
      "    <div class=\"fr-collapse\" id=\"breadcrumb-1\">",
      "        <ol class=\"fr-breadcrumb__list\">",
      "            <li>",
      "                <a class=\"fr-breadcrumb__link\" href=\"/\">Accueil</a>",
      "            </li>",
      "            <li>",
      "                <a class=\"fr-breadcrumb__link\" href=\"/${2:GA-PAYE}/\">${3:GA PAYE}</a>",
      "            </li>",
      "            <li>",
      "                <a class=\"fr-breadcrumb__link\" href=\"/${2}/${4:RenoiRH-GA-PAYE}/\">${5:RenoiRH GA PAYE}</a>",
      "            </li>",
      "            <li>",
      "                <a class=\"fr-breadcrumb__link\" aria-current=\"page\">${1}</a>",
      "            </li>",
      "        </ol>",
      "    </div>",
      "</nav>",
      "",
      "# ${1}",
      "",
      "/// accordion | **Suivi des modifications**",
      "",
      "| **Version** | **Date** | **Emetteur** | **Suivi des modifications** |",
      "|----|----|----|----|",
      "| V${6:1} | $CURRENT_DATE/$CURRENT_MONTH/$CURRENT_YEAR | ${7:MATTE / DSNUMRH4} | ${8:Création} |",
      "",
      "///",
      "",
      "**Documents de référence**",
      "",
      "| **Type du document** | **Origine** | **Nom du document** | **Date** |",
      "|----|----|----|----|",
      "| ${9:Décret} | ${10} | ${11:Intitulé du document} | ${12:JJ/MM/AAAA} |",
      "",
      "## Contexte",
      "",
      "${13:Texte de contexte.}",
      "",
      "## ${14:Titre de la première partie}",
      "",
      "$0"
    ]
  },
  "Doc SIRH : page de rubrique (cartes)": {
    "prefix": [
      "dsfr-sirh-rubrique"
    ],
    "description": "Doc SIRH — page de redirection : fil d'Ariane, titre et une ligne de 3 cartes vers les modes opératoires",
    "body": [
      "<nav role=\"navigation\" class=\"fr-breadcrumb\" aria-label=\"vous êtes ici :\">",
      "    <button class=\"fr-breadcrumb__button\" aria-expanded=\"false\" aria-controls=\"breadcrumb-1\">Voir le fil d’Ariane</button>",
      "    <div class=\"fr-collapse\" id=\"breadcrumb-1\">",
      "        <ol class=\"fr-breadcrumb__list\">",
      "            <li>",
      "                <a class=\"fr-breadcrumb__link\" href=\"/\">Accueil</a>",
      "            </li>",
      "            <li>",
      "                <a class=\"fr-breadcrumb__link\" href=\"/${2:GA-PAYE}/\">${3:GA PAYE}</a>",
      "            </li>",
      "            <li>",
      "                <a class=\"fr-breadcrumb__link\" href=\"/${2}/${4:RenoiRH-GA-PAYE}/\">${5:RenoiRH GA PAYE}</a>",
      "            </li>",
      "            <li>",
      "                <a class=\"fr-breadcrumb__link\" aria-current=\"page\">${1:Titre de la rubrique}</a>",
      "            </li>",
      "        </ol>",
      "    </div>",
      "</nav>",
      "",
      "# ${1}",
      "",
      "/// row | fr-grid-row--gutters",
      "/// col",
      "/// card | ${6:Titre de la fiche}",
      "    image: https://docsirh.e2.rie.gouv.fr/fichiers/${5:Dossier_media/image.png}",
      "    target: ${7:Nom-de-la-page}",
      "    enlarge: True",
      "    variations: shadow",
      "///",
      "///",
      "/// col",
      "/// card | ${8:Titre de la fiche}",
      "    image: https://docsirh.e2.rie.gouv.fr/fichiers/${5}",
      "    target: ${9:Nom-de-la-page}",
      "    enlarge: True",
      "    variations: shadow",
      "///",
      "///",
      "/// col",
      "/// card | ${10:Titre de la fiche}",
      "    image: https://docsirh.e2.rie.gouv.fr/fichiers/${5}",
      "    target: ${11:Nom-de-la-page}",
      "    enlarge: True",
      "    variations: shadow",
      "///",
      "///",
      "///",
      "$0"
    ]
  },
  "Doc SIRH : fil d'Ariane": {
    "prefix": [
      "dsfr-sirh-fil-ariane"
    ],
    "description": "Doc SIRH — fil d'Ariane en HTML (Accueil, rubrique, sous-rubrique, page courante)",
    "body": [
      "<nav role=\"navigation\" class=\"fr-breadcrumb\" aria-label=\"vous êtes ici :\">",
      "    <button class=\"fr-breadcrumb__button\" aria-expanded=\"false\" aria-controls=\"breadcrumb-1\">Voir le fil d’Ariane</button>",
      "    <div class=\"fr-collapse\" id=\"breadcrumb-1\">",
      "        <ol class=\"fr-breadcrumb__list\">",
      "            <li>",
      "                <a class=\"fr-breadcrumb__link\" href=\"/\">Accueil</a>",
      "            </li>",
      "            <li>",
      "                <a class=\"fr-breadcrumb__link\" href=\"/${2:GA-PAYE}/\">${3:GA PAYE}</a>",
      "            </li>",
      "            <li>",
      "                <a class=\"fr-breadcrumb__link\" href=\"/${2}/${4:RenoiRH-GA-PAYE}/\">${5:RenoiRH GA PAYE}</a>",
      "            </li>",
      "            <li>",
      "                <a class=\"fr-breadcrumb__link\" aria-current=\"page\">${1:Titre de la page}</a>",
      "            </li>",
      "        </ol>",
      "    </div>",
      "</nav>",
      "$0"
    ]
  },
  "Doc SIRH : niveau de fil d'Ariane": {
    "prefix": [
      "dsfr-sirh-fil-ariane-niveau"
    ],
    "description": "Doc SIRH — un niveau de plus dans le fil d'Ariane, à placer avant la page courante",
    "body": [
      "            <li>",
      "                <a class=\"fr-breadcrumb__link\" href=\"/${1:chemin/de/la/page}/\">${2:Libellé}</a>",
      "            </li>$0"
    ]
  },
  "Doc SIRH : suivi des modifications": {
    "prefix": [
      "dsfr-sirh-suivi"
    ],
    "description": "Doc SIRH — accordéon « Suivi des modifications » avec le tableau des versions",
    "body": [
      "/// accordion | **Suivi des modifications**",
      "",
      "| **Version** | **Date** | **Emetteur** | **Suivi des modifications** |",
      "|----|----|----|----|",
      "| V${1:1} | $CURRENT_DATE/$CURRENT_MONTH/$CURRENT_YEAR | ${2:MATTE / DSNUMRH4} | ${3:Création} |",
      "",
      "///",
      "$0"
    ]
  },
  "Doc SIRH : nouvelle version": {
    "prefix": [
      "dsfr-sirh-version"
    ],
    "description": "Doc SIRH — ligne à ajouter au tableau « Suivi des modifications », datée du jour",
    "body": [
      "| V${1} | $CURRENT_DATE/$CURRENT_MONTH/$CURRENT_YEAR | ${2:MATTE / DSNUMRH4} | ${3:Mise à jour} |$0"
    ]
  },
  "Doc SIRH : documents de référence": {
    "prefix": [
      "dsfr-sirh-docs-ref"
    ],
    "description": "Doc SIRH — tableau « Documents de référence »",
    "body": [
      "**Documents de référence**",
      "",
      "| **Type du document** | **Origine** | **Nom du document** | **Date** |",
      "|----|----|----|----|",
      "| ${1:Décret} | ${2} | ${3:Intitulé du document} | ${4:JJ/MM/AAAA} |",
      "$0"
    ]
  },
  "Doc SIRH : chemin dans l'application": {
    "prefix": [
      "dsfr-sirh-chemin"
    ],
    "description": "Doc SIRH — chemin de navigation : Domaine › Thème › Action fonctionnelle",
    "body": [
      "```",
      "⮡ Domaine : ${1}",
      " ⮡ Thème : ${2}",
      "  ⮡ Action fonctionnelle : ${3}",
      "```",
      "$0"
    ]
  },
  "Doc SIRH : capture d'écran": {
    "prefix": [
      "dsfr-sirh-capture"
    ],
    "description": "Doc SIRH — capture d'écran hébergée dans fichiers/, avec sa largeur (comme dans les MODOP)",
    "body": [
      "<img",
      "src=\"https://docsirh.e2.rie.gouv.fr/fichiers/${1}\"",
      "alt=\"${2:Description de la capture}\"",
      "style=\"width:${3:6.27}in\" />",
      "",
      "$0"
    ]
  },
  "Doc SIRH : consigne (alerte)": {
    "prefix": [
      "dsfr-sirh-consigne"
